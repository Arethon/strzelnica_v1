# Skopiuj ten plik do .env i uzupełnij wartościami z Supabase Dashboard →
# Project Settings → API, dla projektu DEV (osobny projekt TEST używa tych
# samych zmiennych, ale ustawianych w środowisku uruchamiającym Playwright/CI).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
